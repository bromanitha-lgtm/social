ErrorDocument 400 /errors/400
ErrorDocument 401 /errors/401
ErrorDocument 403 /errors/403
ErrorDocument 404 /errors/404
ErrorDocument 500 /errors/500
ErrorDocument 503 /errors/503

RewriteEngine On

RewriteRule ^errors/400$ index.php?error=400 [L,QSA]
RewriteRule ^errors/401$ index.php?error=401 [L,QSA]
RewriteRule ^errors/403$ index.php?error=403 [L,QSA]
RewriteRule ^errors/404$ index.php?error=404 [L,QSA]
RewriteRule ^errors/500$ index.php?error=500 [L,QSA]
RewriteRule ^errors/503$ index.php?error=503 [L,QSA]